# Upstream code for every paper vlalab implements, wraps or runs, pinned to the commit it was checked
# against. Shallow; nothing is fetched by a plain clone. See thirdparty/README.md.

# 01 VLM
[submodule "thirdparty/smollm"]
	path = thirdparty/smollm
	url = https://github.com/huggingface/smollm
	shallow = true
[submodule "thirdparty/robotics_transformer"]
	path = thirdparty/robotics_transformer
	url = https://github.com/google-research/robotics_transformer
	shallow = true

# 02 data
[submodule "thirdparty/lerobot"]
	path = thirdparty/lerobot
